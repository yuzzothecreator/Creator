# App
APP_NAME=Creator Ecommerce API
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database (async SQLAlchemy + asyncpg) — used by app and Alembic
# Create DB first: createdb ecommerce  (or use docker compose service)
DATABASE_URL=postgresql+asyncpg://creator:creator@localhost:5432/ecommerce

# Optional sync-style DSN for external tools (not required by this app)
DATABASE_URL_SYNC=postgresql://creator:creator@localhost:5432/ecommerce

# JWT
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated origins for local Next.js)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seed demo data on startup (dev only)
SEED_ON_STARTUP=true
